{
  "name": "expense-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply expense-tracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply expense-tracker-db --remote",
    "db:seed:local": "wrangler d1 execute expense-tracker-db --local --file seed/categories.sql",
    "db:seed:remote": "wrangler d1 execute expense-tracker-db --remote --file seed/categories.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-query": "^5.101.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "puppeteer-core": "^25.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  }
}
